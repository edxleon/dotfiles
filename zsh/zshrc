# ~/.zshrc – managed by github.com/edxleon/dotfiles (symlink, edit in the repo)
# Machine-specific additions go in ~/.zshrc.local (not tracked).

# ── History ───────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space extended_history
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep

# ── Environment ───────────────────────────────────────────────────────────────
typeset -U path
path=(~/.local/bin $path)
export EDITOR=vim VISUAL=vim PAGER=less LESS=-R

# AI agents (Claude Code sets CLAUDECODE=1) get a plain shell: no aliases like
# mv -i / cat=bat that would block on prompts or change command output.
[[ -n $CLAUDECODE ]] && return

# ── tmux autostart: every terminal window joins session "main" ─────────────────
# Skipped inside tmux, in VS Code/JetBrains terminals and over SSH.
# Opt out per machine: `export NO_TMUX_AUTOSTART=1` in ~/.zshenv.
# `exec`: detaching (prefix d) closes the window; the session keeps running.
if (( $+commands[tmux] )) && [[ -t 0 && -t 1 && -z $ZSH_EXECUTION_STRING \
      && -z $TMUX && -z $NO_TMUX_AUTOSTART && -z $SSH_CONNECTION \
      && $TERM_PROGRAM != vscode && $TERMINAL_EMULATOR != JetBrains-JediTerm ]]; then
  exec tmux new-session -A -s main
fi

# ── Completion ────────────────────────────────────────────────────────────────
[[ -d ~/.cache/zsh ]] || mkdir -p ~/.cache/zsh
autoload -Uz compinit
_zcd=~/.cache/zsh/zcompdump
if [[ -f $_zcd && -z $_zcd(N.mh+24) ]]; then
  compinit -C -d $_zcd                                     # fast path: dump younger than 24 h
else
  compinit -d $_zcd                                        # full check (compaudit) once a day
fi
unset _zcd
zstyle ':completion:*' menu select                         # Tab cycles through a menu
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'     # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Key bindings ──────────────────────────────────────────────────────────────
bindkey -e                                                 # emacs keys (like PSReadLine)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search                 # ↑ history search by prefix
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search               # ↓
bindkey '^[OB' down-line-or-beginning-search
bindkey '^F' forward-word                                  # with a suggestion: accept one word (→ accepts all)
bindkey '^[[1;5C' forward-word                             # Ctrl+→
bindkey '^[[1;5D' backward-word                            # Ctrl+←
for k in '^[[H' '^[OH' '^[[1~'; do bindkey "$k" beginning-of-line; done   # Home (terminal / tmux variants)
for k in '^[[F' '^[OF' '^[[4~'; do bindkey "$k" end-of-line; done         # End
bindkey '^[[3~' delete-char                                # Delete (forward)
[[ -t 0 ]] && stty -ixon                                   # free Ctrl+S for vim/tmux

# ── Debian/Ubuntu binary names ────────────────────────────────────────────────
(( $+commands[batcat] )) && ! (( $+commands[bat] )) && alias bat=batcat
(( $+commands[fdfind] )) && ! (( $+commands[fd] ))  && alias fd=fdfind

# ── fzf (Ctrl+T files, Ctrl+R history, Alt+C cd) ──────────────────────────────
export FZF_DEFAULT_OPTS='--height 40% --border rounded --layout reverse'
if (( $+commands[fd] || $+commands[fdfind] )); then
  _fd=${commands[fd]:-${commands[fdfind]}}
  export FZF_DEFAULT_COMMAND="$_fd --type f --hidden --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  unset _fd
fi
if (( $+commands[fzf] )); then
  _fzf_init="$(fzf --zsh 2>/dev/null)"                     # fzf ≥ 0.48, one process
  if [[ -n $_fzf_init ]]; then
    eval "$_fzf_init"
  else                                                     # older fzf (Debian 12)
    for f in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh; do
      [[ -r $f ]] && source $f
    done
  fi
  unset _fzf_init
fi

# ── Aliases ───────────────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mv='mv -i' cp='cp -i' ln='ln -i'                     # ask before overwriting
alias h='history'
alias v='vim'
if [[ $OSTYPE == darwin* ]]; then
  alias ports='sudo lsof -nP -iTCP -sTCP:LISTEN'
else
  alias ports='ss -tulpn'
fi

if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --group-directories-first --git'
  alias lt='eza --tree --icons -L 3'
else
  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'
fi
(( $+commands[bat] || $+commands[batcat] )) && alias cat='bat --paging=never'

alias g='git'
alias gs='git status'
alias glog='git log --oneline --graph --decorate -20'
alias gpull='git pull --rebase'
alias gpush='git push'
alias gco='git checkout'
alias gcb='git checkout -b'

if (( $+commands[docker] )); then
  alias dps='docker ps'
  alias dex='docker exec -it'
  alias dlogs='docker logs -f'
  alias dimg='docker images'
  alias dprune='docker system prune -af'
fi

if (( $+commands[apt] )); then
  alias update='sudo apt update && sudo apt upgrade'
elif (( $+commands[brew] )); then
  alias update='brew update && brew upgrade'
fi

# ── Functions ─────────────────────────────────────────────────────────────────
mkcd() { mkdir -p -- "$1" && cd -- "$1"; }                 # create dir and enter it
up()   { cd "$(printf '../%.0s' $(seq 1 ${1:-1}))"; }       # up 3 → cd ../../..

# ── Prompt ────────────────────────────────────────────────────────────────────
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ── zoxide (z <part-of-path>) – init after other prompt hooks, per its docs ────
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# ── Plugins (last: syntax highlighting must be sourced at the very end) ───────
for dir in /usr/share /usr/share/zsh/plugins /opt/homebrew/share /usr/local/share; do
  [[ -r $dir/zsh-autosuggestions/zsh-autosuggestions.zsh ]] \
    && source $dir/zsh-autosuggestions/zsh-autosuggestions.zsh && break
done
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
for dir in /usr/share /usr/share/zsh/plugins /opt/homebrew/share /usr/local/share; do
  [[ -r $dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
    && source $dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh && break
done
unset dir f
