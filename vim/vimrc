" ~/.vimrc – managed by github.com/edxleon/dotfiles
" Vim 9.1+ (ships with macOS and Debian 13). Few plugins, built-ins first.

" ── Basics ────────────────────────────────────────────────────────────────────
" Vim's own sensible defaults (skipped automatically once a ~/.vimrc exists):
" filetype/syntax on, incsearch, scrolloff, restore cursor position, nrformats …
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

set encoding=utf-8
set fileformats=unix,dos,mac
set history=1000
set hidden
set updatetime=300
set number
set cursorline
set showcmd
set title
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set signcolumn=auto
set backspace=indent,eol,start
set splitright splitbelow
set mouse=a
set listchars=tab:▸\ ,trail:·,eol:¬
set statusline=\ %f\ %m%r%=%y\ \ %l:%c\ \ %p%%\

" System clipboard: X11/Wayland/WSL use '+', macOS uses '*'
if has('unnamedplus') | set clipboard=unnamedplus | else | set clipboard=unnamed | endif

" Persistent undo, no swap/backup files
if !isdirectory(expand('~/.vim/undo')) | call mkdir(expand('~/.vim/undo'), 'p') | endif
set undodir=~/.vim/undo undofile
set noswapfile nobackup nowritebackup

" Search
set hlsearch incsearch ignorecase smartcase

" Indentation (filetype indent rules take precedence)
set expandtab tabstop=4 shiftwidth=4 softtabstop=4
set autoindent
set wrap linebreak
set scrolloff=5

" Alt+hjkl arrives as Esc-prefix in terminal Vim; short timeout keeps plain Esc instant
set ttimeout ttimeoutlen=10

" ── Built-in packages (Vim 9.1): gc/gcc comments, auto-clear search highlight ─
silent! packadd! comment
silent! packadd! nohlsearch

" ── Leader & mappings ─────────────────────────────────────────────────────────
let mapleader = ","
nnoremap <leader>w :w<CR>
nnoremap <leader>l :set list!<CR>
nnoremap <leader>e :Lexplore<CR>
nnoremap <leader>ev :vsp $MYVIMRC<CR>
nnoremap <leader>et :vsp ~/.config/tmux/tmux.conf<CR>
nnoremap <leader>ez :vsp ~/.zshrc<CR>

" ── Plugins (vim-plug, installed by install.sh) ───────────────────────────────
if filereadable(expand('~/.vim/autoload/plug.vim'))
  call plug#begin('~/.vim/plugged')
  Plug 'junegunn/fzf'                    " uses the fzf binary from brew/apt
  Plug 'junegunn/fzf.vim'                " :Files :Buffers :Rg
  Plug 'christoomey/vim-tmux-navigator'  " Alt+hjkl across vim splits and tmux panes
  Plug 'tpope/vim-fugitive'              " :Git
  call plug#end()
endif

" fzf.vim
nnoremap <leader>f :Files<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>r :Rg<CR>

" vim-tmux-navigator on Alt+hjkl (matches tmux.conf)
let g:tmux_navigator_no_mappings = 1
execute "set <M-h>=\eh" | execute "set <M-j>=\ej"
execute "set <M-k>=\ek" | execute "set <M-l>=\el"
nnoremap <silent> <M-h> :TmuxNavigateLeft<CR>
nnoremap <silent> <M-j> :TmuxNavigateDown<CR>
nnoremap <silent> <M-k> :TmuxNavigateUp<CR>
nnoremap <silent> <M-l> :TmuxNavigateRight<CR>

" ── Colors: retrobox (built-in gruvbox look, matches tmux + starship) ─────────
if has('termguicolors') | set termguicolors | endif
set background=dark
silent! colorscheme retrobox

" ── Machine-specific overrides (not tracked) ──────────────────────────────────
if filereadable(expand('~/.vimrc.local')) | source ~/.vimrc.local | endif
