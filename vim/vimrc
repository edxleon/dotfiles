" ~/.vimrc – managed by github.com/edxleon/dotfiles
" Also loaded by Neovim via nvim/init.vim. Plugins: vim-plug (installed by install.sh).

" ── Bootstrap ────────────────────────────────────────────────────────────────
set nocompatible
filetype plugin indent on
syntax on

" ── General ───────────────────────────────────────────────────────────────────
set encoding=utf-8
set fileformats=unix,dos,mac
set history=1000
set hidden
set updatetime=300
set number
set cursorline
set ruler
set showcmd
set noshowmode                  " airline shows the mode
set title
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set signcolumn=yes
set backspace=indent,eol,start
set splitright
set splitbelow
set mouse=a
set listchars=tab:▸\ ,trail:·,eol:¬

" System clipboard: X11/Wayland/WSL use '+', macOS uses '*'
if has('unnamedplus') | set clipboard=unnamedplus | else | set clipboard=unnamed | endif

" Persistent undo, no swap/backup files
let s:undo = has('nvim') ? stdpath('state') . '/undo' : expand('~/.vim/undo')
if !isdirectory(s:undo) | call mkdir(s:undo, 'p') | endif
let &undodir = s:undo
set undofile
set noswapfile nobackup nowritebackup

" ── Search ────────────────────────────────────────────────────────────────────
set hlsearch incsearch ignorecase smartcase
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

" ── Indentation ───────────────────────────────────────────────────────────────
set expandtab tabstop=4 shiftwidth=4 softtabstop=4
set autoindent smartindent
set wrap linebreak
set scrolloff=5

" ── Leader & mappings ─────────────────────────────────────────────────────────
let mapleader = ","
nnoremap <leader>w :w!<CR>
nnoremap <leader>y "+y
nnoremap <leader>ev :vsp $MYVIMRC<CR>
nnoremap <leader>et :vsp ~/.config/tmux/tmux.conf<CR>
nnoremap <leader>ez :vsp ~/.zshrc<CR>
nnoremap <leader>l :set list!<CR>

" Resize tmux/vim splits with Ctrl+a/s/d (vim-tmux-resizer); Ctrl+w stays vim's window prefix
let g:tmux_resizer_no_mappings = 1
nnoremap <silent> <C-a> :TmuxResizeLeft<CR>
nnoremap <silent> <C-s> :TmuxResizeDown<CR>
nnoremap <silent> <C-d> :TmuxResizeRight<CR>

" Move between vim splits and tmux panes with Alt+hjkl (matches tmux.conf)
let g:tmux_navigator_no_mappings = 1
nnoremap <silent> <M-h> :TmuxNavigateLeft<CR>
nnoremap <silent> <M-j> :TmuxNavigateDown<CR>
nnoremap <silent> <M-k> :TmuxNavigateUp<CR>
nnoremap <silent> <M-l> :TmuxNavigateRight<CR>
if !has('nvim')                 " terminal vim receives Alt as Esc-prefix
  execute "set <M-h>=\eh" | execute "set <M-j>=\ej"
  execute "set <M-k>=\ek" | execute "set <M-l>=\el"
  set ttimeout ttimeoutlen=10   " so a plain Esc isn't delayed
endif

" Restore cursor position when reopening a file
autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif

" ── Plugins ───────────────────────────────────────────────────────────────────
if filereadable(expand('~/.vim/autoload/plug.vim'))
call plug#begin('~/.vim/plugged')

" Navigation
Plug 'preservim/nerdtree', { 'on': 'NERDTreeToggle' }
Plug 'junegunn/fzf'
Plug 'junegunn/fzf.vim'
Plug 'christoomey/vim-tmux-navigator'
Plug 'melonmanchan/vim-tmux-resizer'
Plug 'easymotion/vim-easymotion'

" Git
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" UI
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'Yggdroot/indentLine'
Plug 'morhetz/gruvbox'

" Editing
Plug 'tpope/vim-surround'
Plug 'preservim/nerdcommenter'
Plug 'jiangmiao/auto-pairs'

" Languages, linting & fixing (replaces syntastic, YouCompleteMe, flake8, autopep8)
Plug 'sheerun/vim-polyglot'
Plug 'dense-analysis/ale'

call plug#end()
endif

" ── Colors: Gruvbox dark ──────────────────────────────────────────────────────
if has('termguicolors') | set termguicolors | endif
set background=dark
let g:gruvbox_contrast_dark = 'medium'
silent! colorscheme gruvbox

" ── Airline ───────────────────────────────────────────────────────────────────
let g:airline_theme = 'gruvbox'
let g:airline_powerline_fonts = 1
let g:airline#extensions#tabline#enabled = 1

" ── NERDTree ──────────────────────────────────────────────────────────────────
nnoremap <leader>n :NERDTreeToggle<CR>
let NERDTreeShowHidden = 1
autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1 &&
    \ exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" ── fzf.vim ───────────────────────────────────────────────────────────────────
nnoremap <leader>f :Files<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>r :Rg<CR>

" ── NERDCommenter ─────────────────────────────────────────────────────────────
let g:NERDSpaceDelims = 1
let g:NERDDefaultAlign = 'left'
let g:NERDCommentEmptyLines = 1
let g:NERDTrimTrailingWhitespace = 1

" ── IndentLine ────────────────────────────────────────────────────────────────
let g:indentLine_fileTypeExclude = ['tex', 'json', 'markdown']

" ── ALE: lint on save, fix with <leader>F, LSP completion where available ─────
let g:ale_linters = { 'python': ['ruff'], 'sh': ['shellcheck'] }
let g:ale_fixers  = { '*': ['remove_trailing_lines', 'trim_whitespace'], 'python': ['ruff_format'] }
let g:ale_python_ruff_options = '--line-length 120'
let g:ale_completion_enabled = 1
nnoremap <leader>F :ALEFix<CR>
nmap <silent> [e <Plug>(ale_previous_wrap)
nmap <silent> ]e <Plug>(ale_next_wrap)
